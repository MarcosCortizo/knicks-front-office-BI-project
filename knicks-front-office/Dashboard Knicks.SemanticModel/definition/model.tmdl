model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-ES
	maxParallelismPerRefresh: 1
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 1

queryGroup Bridges

	annotation PBI_QueryGroupOrder = 2

queryGroup Sports

	annotation PBI_QueryGroupOrder = 3

queryGroup Finance

	annotation PBI_QueryGroupOrder = 4

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["CsvFolder","dim_season","dim_phase","dim_team","dim_player","dim_date","dim_game","bridge_roster_season","fact_team_season","fact_player_season","fact_knicks_player_advanced","fact_player_game","fact_injury","fact_playoff_series","fact_coach_season","fact_coaching_staff","fact_salary_player_season","fact_cap_rules","fact_financial_statement","fact_commercial_agreement","fact_awards","dim_account","_Measures"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode","CalcGroup"]

ref table dim_season
ref table dim_phase
