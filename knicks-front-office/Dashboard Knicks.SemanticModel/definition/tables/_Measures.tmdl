	measure 'Series Result' =
			
			VAR _s = FILTER ( fact_playoff_series, fact_playoff_series[team_a_id] = "NYK" || fact_playoff_series[team_b_id] = "NYK" )
			VAR _a = MAXX ( _s, fact_playoff_series[team_a_id] )
			VAR _b = MAXX ( _s, fact_playoff_series[team_b_id] )
			VAR _wa = MAXX ( _s, fact_playoff_series[wins_a] )
			VAR _wb = MAXX ( _s, fact_playoff_series[wins_b] )
			RETURN IF ( NOT ISEMPTY ( _s ), IF ( _a = "NYK", _wa & "-" & _wb & " vs " & _b, _wb & "-" & _wa & " vs " & _a ) )
		displayFolder: Home
		lineageTag: 141030e9-c2e7-44f4-8d07-8e134fa2bf8f

