	measure 'Profile Roster Pct' =
			
			VAR _me = [Adv Value]
			VAR _pool =
			    CALCULATETABLE (
			        FILTER (
			            ADDCOLUMNS (
			                VALUES ( dim_player[player_id] ),
			                "@v", [Adv Value],
			                "@m", CALCULATE ( SUM ( fact_player_season[mp] ), fact_player_season[scope] = "TEAM" )
			            ),
			            NOT ISBLANK ( [@v] ) && [@m] >= 200
			        ),
			        REMOVEFILTERS ( dim_player )
			    )
			VAR _n = COUNTROWS ( _pool )
			VAR _below = COUNTROWS ( FILTER ( _pool, [@v] < _me ) ) + 0
			RETURN IF ( NOT ISBLANK ( _me ) && _n > 1, MIN ( DIVIDE ( _below, _n - 1 ), 1 ) )
		formatString: 0%
		displayFolder: Profile
		lineageTag: 2b80fd82-53ef-4e73-a007-a020202869fe

	measure 'Games Played Log' = CALCULATE ( COUNTROWS ( fact_player_game ), fact_player_game[did_not_play] = 0, fact_player_game[team_id] = "NYK" )
		formatString: 0
		displayFolder: Profile
		lineageTag: db402adb-9e2d-4b7c-838b-af4893356273

	measure 'Avg PTS Log' = DIVIDE ( [Game PTS], [Games Played Log] )
		formatString: 0.0
		displayFolder: Profile
		lineageTag: c764d6c3-4606-4c12-8794-b48d9f45e308

	measure 'Avg MIN Log' = DIVIDE ( [Game MIN], [Games Played Log] )
		formatString: 0.0
		displayFolder: Profile
		lineageTag: fc60db63-a810-4c1e-a223-5e6e3397bf08

	measure 'Games Missed' =
			
			VAR _m = [Games] - [Games Played Log]
			RETURN IF ( _m > 0, _m )
		formatString: 0
		displayFolder: Profile
		lineageTag: 0d758b19-f3aa-4e90-b90f-cff7ab9f7d2e

	measure 'Absence Games' =
			
			VAR _r = SELECTEDVALUE ( 'Absence Reason'[Reason] )
			VAR _listed = CALCULATE ( [Absences], TREATAS ( { _r }, fact_player_game[absence_type] ) )
			VAR _unlisted = [Games Missed] - [Absences]
			RETURN
			    SWITCH ( TRUE (),
			        NOT HASONEVALUE ( 'Absence Reason'[Reason] ), [Games Missed],
			        _r = "Inactive", IF ( _unlisted > 0, _unlisted ),
			        _listed
			    )
		formatString: 0
		displayFolder: Profile
		lineageTag: d032d53c-a6fc-4cb1-b416-de3ee41db94f

	measure 'Missed Games' =
			
			VAR _box =
			    SELECTCOLUMNS (
			        CALCULATETABLE ( fact_player_game, fact_player_game[did_not_play] = 1, fact_player_game[team_id] = "NYK" ),
			        "g", fact_player_game[game_id], "p", fact_player_game[player_id]
			    )
			VAR _rep =
			    SELECTCOLUMNS (
			        CALCULATETABLE ( fact_injury, fact_injury[status] = "Out" ),
			        "g", fact_injury[game_id], "p", fact_injury[player_id]
			    )
			VAR _n = COUNTROWS ( DISTINCT ( UNION ( _box, _rep ) ) )
			RETURN IF ( _n > 0, _n )
		formatString: 0
		displayFolder: Health
		lineageTag: 0813354c-5fd2-4823-b88e-a1747c0e82df

	measure 'Missed to Injury' =
			
			VAR _box =
			    SELECTCOLUMNS (
			        CALCULATETABLE ( fact_player_game, fact_player_game[did_not_play] = 1, fact_player_game[team_id] = "NYK", fact_player_game[absence_type] = "Injury" ),
			        "g", fact_player_game[game_id], "p", fact_player_game[player_id]
			    )
			VAR _rep =
			    SELECTCOLUMNS (
			        CALCULATETABLE ( fact_injury, fact_injury[status] = "Out", fact_injury[category] = "Injury" ),
			        "g", fact_injury[game_id], "p", fact_injury[player_id]
			    )
			VAR _n = COUNTROWS ( DISTINCT ( UNION ( _box, _rep ) ) )
			RETURN IF ( _n > 0, _n )
		formatString: 0
		displayFolder: Health
		lineageTag: e4c37823-e34e-4734-95c8-14788c536de6

