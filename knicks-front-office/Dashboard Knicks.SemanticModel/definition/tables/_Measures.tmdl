table _Measures
	lineageTag: 1cdff483-0556-40b7-bfe4-f9b15d8f8838

	measure Games =
			
			VAR TeamId = "NYK"
			RETURN
			    COUNTROWS (
			        FILTER (
			            dim_game,
			            dim_game[home_team_id] = TeamId
			                || dim_game[away_team_id] = TeamId
			        )
			    )
		formatString: 0
		displayFolder: Results
		lineageTag: b2f3c365-98e1-4421-a859-73119751b9c7

	measure Wins =
			
			CALCULATE ( COUNTROWS ( dim_game ), dim_game[winner_team_id] = "NYK" )
		formatString: 0
		displayFolder: Results
		lineageTag: 0fbc39c3-a2b7-4130-8779-b0c52be9bddd

	measure Losses =
			
			[Games] - [Wins]
		formatString: 0
		displayFolder: Results
		lineageTag: 825ef046-71bf-428a-94b3-199d5b8567d0

	measure 'Win %' =
			
			DIVIDE ( [Wins], [Games] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Results
		lineageTag: 033383d5-f705-472a-a74f-14a2225e3403

	measure Record =
			
			[Wins] & "-" & [Losses]
		displayFolder: Results
		lineageTag: 31d5c30a-e76f-46e5-9db6-5a6d0ff7feb6

	measure 'Standing or Round' =
			
			VAR TeamId = "NYK"
			VAR PhaseSel = SELECTEDVALUE ( dim_phase[phase_id] )
			
			-- Regular season: conference standing, e.g. "3rd East"
			VAR ConfRank =
			    CALCULATE (
			        MAX ( fact_team_season[conference_rank] ),
			        fact_team_season[team_id] = TeamId,
			        dim_phase[phase_id] = "REG"
			    )
			VAR Suffix =
			    SWITCH (
			        TRUE (),
			        ConfRank IN { 11, 12, 13 }, "th",
			        MOD ( ConfRank, 10 ) = 1, "st",
			        MOD ( ConfRank, 10 ) = 2, "nd",
			        MOD ( ConfRank, 10 ) = 3, "rd",
			        "th"
			    )
			VAR ConfName =
			    IF ( LOOKUPVALUE ( dim_team[conference], dim_team[team_id], TeamId ) = "E", "East", "West" )
			
			-- Playoffs: last series played and who won it
			VAR TeamSeries =
			    FILTER (
			        fact_playoff_series,
			        fact_playoff_series[team_a_id] = TeamId
			            || fact_playoff_series[team_b_id] = TeamId
			    )
			VAR LastRound = MAXX ( TeamSeries, fact_playoff_series[round_num] )
			VAR LastSeries = FILTER ( TeamSeries, fact_playoff_series[round_num] = LastRound )
			VAR LastName = MAXX ( LastSeries, fact_playoff_series[round_name] )
			VAR LastWinner = MAXX ( LastSeries, fact_playoff_series[winner_team_id] )
			
			RETURN
			    SWITCH (
			        PhaseSel,
			        "REG", ConfRank & Suffix & " " & ConfName,
			        "PO", IF ( LastWinner = TeamId && LastRound = 4, "NBA Champions", "Lost in " & LastName ),
			        BLANK ()
			    )
		displayFolder: Results
		lineageTag: 7cc848df-878d-412c-866d-d29295de5dfd

	measure 'Net Rating' =
			
			CALCULATE ( MAX ( fact_team_season[net_rtg] ), fact_team_season[team_id] = "NYK" )
		formatString: +0.0;-0.0;0.0
		displayFolder: Team
		lineageTag: 76a2a38a-d34c-4633-9528-4f1b0721914c

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Stat Value' =
			
			VAR S = SELECTEDVALUE ( 'Team Stats'[Stat] )
			VAR G = SUM ( fact_team_season[g] )
			RETURN
			    SWITCH (
			        S,
			        "PTS",     DIVIDE ( SUM ( fact_team_season[pts] ), G ),
			        "Opp PTS", DIVIDE ( SUM ( fact_team_season[opp_pts] ), G ),
			        "REB",     DIVIDE ( SUM ( fact_team_season[trb] ), G ),
			        "AST",     DIVIDE ( SUM ( fact_team_season[ast] ), G ),
			        "TOV",     DIVIDE ( SUM ( fact_team_season[tov] ), G ),
			        "STL",     DIVIDE ( SUM ( fact_team_season[stl] ), G ),
			        "BLK",     DIVIDE ( SUM ( fact_team_season[blk] ), G ),
			        "FG%",     DIVIDE ( SUM ( fact_team_season[fg] ),  SUM ( fact_team_season[fga] ) ),
			        "3P%",     DIVIDE ( SUM ( fact_team_season[fg3] ), SUM ( fact_team_season[fg3a] ) ),
			        "FT%",     DIVIDE ( SUM ( fact_team_season[ft] ),  SUM ( fact_team_season[fta] ) )
			    )
		isHidden
		displayFolder: Team
		lineageTag: 5f23e9ea-de39-4fbc-8e89-b4a96aac6b64

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Knicks = ```
			
			   CALCULATE ( [Stat Value], dim_team[team_id] = "NYK" )
			```
		displayFolder: Team
		lineageTag: d6f01708-cdd7-4f66-9647-f57467a2bb58

		formatStringDefinition = IF ( SELECTEDVALUE ( 'Team Stats'[Is Pct] ) = 1, "0.0%", "0.0" )

	measure 'NBA Average' =
			
			AVERAGEX (
			    FILTER ( ALL ( dim_team[team_id] ), NOT ISBLANK ( [Stat Value] ) ),
			    [Stat Value]
			)
		displayFolder: Team
		lineageTag: 4b73a5d1-a7b7-4690-8fe2-00e074c8b5de

		formatStringDefinition = IF ( SELECTEDVALUE ( 'Team Stats'[Is Pct] ) = 1, "0.0%", "0.0" )

	measure 'NBA Rank' =
			
			VAR NykValue = [Knicks]
			VAR Teams = FILTER ( ALL ( dim_team[team_id] ), NOT ISBLANK ( [Stat Value] ) )
			RETURN
			    IF (
			        SELECTEDVALUE ( 'Team Stats'[Lower Is Better] ) = 1,
			        RANKX ( Teams, [Stat Value], NykValue, ASC, SKIP ),
			        RANKX ( Teams, [Stat Value], NykValue, DESC, SKIP )
			    )
		formatString: 0
		displayFolder: Team
		lineageTag: f5abbc0c-c3cc-40e8-b9fe-97210240d63b

	measure 'Game Margin' =
			
			VAR TeamId = "NYK"
			RETURN
			    SUMX (
			        FILTER (
			            dim_game,
			            dim_game[home_team_id] = TeamId
			                || dim_game[away_team_id] = TeamId
			        ),
			        IF (
			            dim_game[home_team_id] = TeamId,
			            dim_game[home_pts] - dim_game[away_pts],
			            dim_game[away_pts] - dim_game[home_pts]
			        )
			    )
		displayFolder: Results
		lineageTag: 157bcc8c-40be-43c7-ac67-18c641d1ebc7

		formatStringDefinition = "+0;-0;0"

	measure 'Results Title' = ```
			
			VAR SeasonTxt = SELECTEDVALUE ( dim_season[season_label] )
			VAR PhaseTxt = SELECTEDVALUE ( dim_phase[phase_name] )
			RETURN
			    SeasonTxt & " " & PhaseTxt & "  " & [Record] & " V/D "
			      
			```
		displayFolder: Labels
		lineageTag: 3dfc32ad-8ff1-4d1a-8996-5ae23fad84f8

