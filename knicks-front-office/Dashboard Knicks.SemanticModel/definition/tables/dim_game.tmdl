	column is_knicks_game
		dataType: int64
		formatString: 0
		lineageTag: 9b0fda6a-f6e0-4c75-bf30-54a8cba0c1f0
		summarizeBy: none
		sourceColumn: is_knicks_game

		annotation SummarizationSetBy = User

	column 'Knicks Game No' = VAR _d = dim_game[game_date] VAR _s = dim_game[season_id] VAR _p = dim_game[phase_id] RETURN IF ( dim_game[is_knicks_game] = 1, COUNTROWS ( FILTER ( dim_game, dim_game[season_id] = _s && dim_game[phase_id] = _p && dim_game[is_knicks_game] = 1 && dim_game[game_date] <= _d ) ) )
		dataType: int64
		formatString: 0
		lineageTag: f8234f8f-6661-4d4d-8164-e81c8d99ed51
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition dim_game = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "dim_game.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"game_id", "season_id", "phase_id", "game_date", "home_team_id", "away_team_id", "home_pts", "away_pts", "winner_team_id", "attendance"}),
				    ChangedTypes = Table.TransformColumnTypes(SelectedColumns, {{"game_id", type text}, {"season_id", Int64.Type}, {"phase_id", type text}, {"game_date", type date}, {"home_team_id", type text}, {"away_team_id", type text}, {"home_pts", Int64.Type}, {"away_pts", Int64.Type}, {"winner_team_id", type text}, {"attendance", Int64.Type}}, "en-US"),
				    IsKnicks = Table.AddColumn(ChangedTypes, "is_knicks_game", each if [home_team_id] = "NYK" or [away_team_id] = "NYK" then 1 else 0, Int64.Type)
				in
				    IsKnicks

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

