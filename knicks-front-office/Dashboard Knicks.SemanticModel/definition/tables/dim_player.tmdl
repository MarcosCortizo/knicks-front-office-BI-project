	partition dim_player = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "dim_player.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"player_id", "player_name"}),
				    ChangedTypes = Table.TransformColumnTypes(SelectedColumns, {{"player_id", type text}, {"player_name", type text}}, "en-US")
