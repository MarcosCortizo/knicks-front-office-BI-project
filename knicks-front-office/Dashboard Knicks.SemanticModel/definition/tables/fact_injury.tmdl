	column 'Injury Label' = VAR _s = fact_injury[body_side] VAR _b = fact_injury[body_part] VAR _t = fact_injury[injury_type] VAR _x = TRIM ( IF ( LEN ( _s ) > 0, _s & " " ) & IF ( LEN ( _b ) > 0, LOWER ( _b ) & " " ) & LOWER ( _t ) ) RETURN UPPER ( LEFT ( _x, 1 ) ) & MID ( _x, 2, 200 )
		dataType: string
		lineageTag: ddf5797c-37d0-477f-abe2-196985ba2679
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_injury = m
		mode: import
		queryGroup: Sports
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "fact_injury.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"game_id", "player_id", "report_date", "status", "category", "body_side", "body_part", "injury_type"}),
				    ChangedTypes = Table.TransformColumnTypes(SelectedColumns, {{"game_id", type text}, {"player_id", type text}, {"report_date", type date}, {"status", type text}, {"category", type text}, {"body_side", type text}, {"body_part", type text}, {"injury_type", type text}}, "en-US")
				in
				    ChangedTypes

	annotation PBI_NavigationStepName = Navigation

