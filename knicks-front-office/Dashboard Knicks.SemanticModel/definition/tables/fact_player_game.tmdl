		sourceColumn: minutes_num

		annotation SummarizationSetBy = User

	partition fact_player_game = m
		mode: import
		queryGroup: Sports
		source =
				let
				    Source = Csv.Document(File.Contents(CsvFolder & "fact_player_game.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    SelectedColumns = Table.SelectColumns(PromotedHeaders, {"game_id", "team_id", "player_id", "did_not_play", "absence_reason", "minutes", "pts", "plus_minus"}),
				    ChangedTypes = Table.TransformColumnTypes(SelectedColumns, {{"game_id", type text}, {"team_id", type text}, {"player_id", type text}, {"did_not_play", Int64.Type}, {"absence_reason", type text}, {"minutes", type text}, {"pts", Int64.Type}, {"plus_minus", type number}}, "en-US"),
				    AbsenceType = Table.AddColumn(ChangedTypes, "absence_type", each if [did_not_play] <> 1 then null else let r = if [absence_reason] = null then "" else [absence_reason] in if Text.Contains(r, "COACH") then "Coach decision" else if r = "ILLNESS" or r = "NON-COVID ILLNESS" then "Illness" else if r = "PERSONAL" or r = "NOT WITH TEAM" then "Personal" else if r = "SUSPENDED BY LEAGUE" then "Suspension" else if r = "Did Not Play" or r = "" then "No reason" else "Injury", type text),
				    MinutesNumber = Table.AddColumn(AbsenceType, "minutes_num", each try Number.FromText([minutes], "en-US") otherwise null, type nullable number)
				in
				    MinutesNumber

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

